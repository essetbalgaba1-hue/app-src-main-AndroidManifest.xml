<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <EditText
        android:id="@+id/etSearchQuery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Кого ищем? (например: бухгалтер)"
        android:text="бухгалтер"
        android:singleLine="true" />

    <EditText
        android:id="@+id/etMessageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Текст сообщения"
        android:maxLines="3"
        android:textSize="12sp"
        android:text="Здравствуйте, меня зовут Мирас. Я программист, более 7 лет занимаюсь на удалёнке, помогаю людям восстанавливать файлы, а также настройка принтеров, активация офисов, экселей, а также удаление вирусов и установка антивирусов и так далее. Если что, пишите, можем обсудить по решению задачи и озвучить цену. После оплата на каспи. Мой номер телефона: 8 771 608 04 17, с уважением Мирас." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="СТАРТ"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="СТОП"
            android:backgroundTint="#C62828"
            android:textColor="#FFFFFF"
            android:enabled="false"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Статус: Войдите в аккаунт OLX и нажмите СТАРТ"
        android:textStyle="bold"
        android:padding="4dp"
        android:textSize="13sp" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
